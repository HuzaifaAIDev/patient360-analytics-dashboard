# ==============================================================================
# Used ONLY by `docker compose` for variable substitution in docker-compose.yml
# (the Postgres container's credentials). Copy this to `.env` in the project
# root before running `docker compose up`.
#
# The backend itself reads its OWN separate `.env` file at `backend/.env` —
# see backend/.env.example for the full list of backend settings. When
# running under Docker Compose, docker-compose.yml overrides the backend's
# DATABASE_URL to point at the `db` service using these same values, so keep
# DB_NAME / DB_USER / DB_PASSWORD consistent between the two files.
# ==============================================================================

DB_NAME=patient360_db
DB_USER=patient360_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
