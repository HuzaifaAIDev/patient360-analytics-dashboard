# ==============================================================================
# Patient 360 Analytics Dashboard - Backend Environment Configuration
# Copy this file to `.env` and fill in the values for your environment.
# NEVER commit your real `.env` file — only `.env.example` belongs in git.
# ==============================================================================

# --- Application ---
APP_NAME=Patient 360 Analytics Dashboard
# development | production — production disables verbose error detail
# (see DEBUG below) and is used for HSTS gating.
APP_ENV=development
# Never set this to true in production — it puts exception type/message
# text into 500 responses, which is useful locally and unsafe publicly.
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Karachi

# --- API documentation ---
# true (development default): /api/docs, /api/redoc, /api/openapi.json are
# all served. Set to false for production to disable them outright (not
# just hide the UI — the OpenAPI schema itself stops being served too).
API_DOCS_ENABLED=true

# --- CORS ---
# Allowed frontend origins are NOT configured here — they live in the
# `allowed_origins` SQL table instead, so they can be changed by whoever
# administers the database without redeploying the backend. On first boot
# against an empty database, http://localhost:5173 and http://127.0.0.1:5173
# are inserted automatically so the bundled frontend still works out of the
# box; add/disable/remove rows in that table to change what's allowed
# (see docs/Database_Connection_Guide.pdf and the in-app "Database" page).
# This only controls how often the in-memory cache re-reads that table:
CORS_CACHE_TTL_SECONDS=30

# --- Security headers ---
# HSTS is only ever sent when this is true AND the request actually arrived
# over HTTPS — it is never sent over plain HTTP, so this is safe to leave
# on even for local http://localhost development.
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# --- Rate limiting ---
# IP-based (there is no login/user system in this app). Health checks are
# always exempt so monitoring can't be broken by these limits.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_EXPORT_PER_MINUTE=10

# --- Request size limits ---
# This app never accepts file uploads, so a small ceiling is plenty.
MAX_REQUEST_BODY_BYTES=1048576

# --- AI Provider (Gemini-compatible) ---
# Leave AI_API_KEY empty to run the application with AI Summary disabled.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=20
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Analytics ---
# Minimum number of occurrences for a disease to be flagged as "recurring"
RECURRING_DISEASE_THRESHOLD=2

# --- Security (reserved for future use) ---
SECRET_KEY=change-this-in-production

# ==============================================================================
# DATABASE — this is the ONLY place database credentials live.
#
# Two ways to configure the connection (pick ONE approach):
#
#   1) DATABASE_URL — a single connection string. If set, it takes priority
#      over every DB_* field below. This is the recommended approach for
#      production / managed databases (Render, RDS, Supabase, Azure SQL…),
#      since most of them just hand you one connection string.
#
#   2) DB_DRIVER / DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD — set
#      these individually instead if your secrets are injected as separate
#      values (common with Kubernetes secrets / some CI systems). Leave
#      DATABASE_URL empty to use these.
#
# Swapping databases (SQLite -> PostgreSQL -> MySQL -> SQL Server) is a
# config-only change — no code changes required anywhere in the app.
# ==============================================================================

# --- Option 1: single connection string (uncomment ONE of the examples) ---
# DATABASE_URL=postgresql+psycopg2://patient360_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/patient360_db
# DATABASE_URL=mysql+pymysql://patient360_user:CHANGE_ME_STRONG_PASSWORD@localhost:3306/patient360_db
# DATABASE_URL=mssql+pyodbc://patient360_user:CHANGE_ME_STRONG_PASSWORD@localhost:1433/patient360_db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=sqlite:///./patient360_dummy.db

# --- Option 2: individual fields (used only if DATABASE_URL is empty) ---
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patient360_db
DB_USER=patient360_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Connection security & pooling ---
# DB_SSL_MODE (PostgreSQL only): disable | allow | prefer | require | verify-ca | verify-full
# Use "require" or stricter for any non-local database.
DB_SSL_MODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# Set to true only for local debugging — logs every SQL statement, including
# parameter values, so never enable this in production.
DB_ECHO_SQL=false

# --- SQL Server (mssql+pyodbc) specific ---
# Only consulted when DB_DRIVER (or a DATABASE_URL you build yourself)
# targets mssql+pyodbc. Requires the `pyodbc` package (already in
# requirements.txt) AND the unixODBC driver manager plus a Microsoft ODBC
# Driver installed at the OS level — see docs/Database_Connection_Guide.pdf.
# Encryption defaults ON with certificate validation ON; don't weaken these
# for a real deployment.
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
